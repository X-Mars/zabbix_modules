{
  "manifest_version": 2.0,
  "id": "zabbix-rebrand-logo",
  "name": "Zabbix Rebrand Logo",
  "author": "Keberneth/火星小刘",
  "url": "https://github.com/X-Mars/zabbix_modules",
  "namespace": "ZabbixRebrandLogo",
  "version": "1.1.0",
  "type": "module",
  "description": "Replace the login and sidebar logos and browser favicon, and customize the server name, footer, and help link. / 更换登录页和侧边栏标志及浏览器图标，并自定义服务器名称、页脚和帮助链接。",
  "actions": {
    "rebrand.config": {
      "class": "RebrandConfig",
      "view": "rebrand.config",
      "layout": "layout.htmlpage"
    },
      "rebrand.config.update": {
      "class": "RebrandConfigUpdate"
    }
  },
  "assets": {
    "css": [
      "rebrand.css"
    ]
  }
}
