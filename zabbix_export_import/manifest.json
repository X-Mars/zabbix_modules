{
  "manifest_version": 2.0,
  "id": "zabbix-import-export",
  "name": "Zabbix Import/Export",
  "version": "1.3.1",
  "namespace": "ZabbixImportExport",
  "author": "X-Mars",
  "description": "Portable hosts, monitoring templates and host items",
  "actions": {
    "importexport.hosts": {
      "class": "Transfer",
      "view": "transfer"
    },
    "importexport.items": {
      "class": "Transfer",
      "view": "transfer"
    },
    "importexport.templates": {
      "class": "Transfer",
      "view": "transfer"
    }
  }
}
