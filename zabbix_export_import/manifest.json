{
  "manifest_version": 2.0,
  "id": "zabbix-export-import",
  "name": "Zabbix Export Import",
  "author": "火星小刘",
  "url": "https://github.com/X-Mars/zabbix_modules",
  "version": "1.3.1",
  "namespace": "ZabbixExportImport",
  "description": "Portable hosts, monitoring templates and host items",
  "actions": {
    "importexport.hosts": {
      "class": "Transfer",
      "view": "transfer"
    },
    "importexport.items": {
      "class": "Transfer",
      "view": "transfer"
    },
    "importexport.templates": {
      "class": "Transfer",
      "view": "transfer"
    }
  }
}
