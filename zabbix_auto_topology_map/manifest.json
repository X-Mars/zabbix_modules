{
    "manifest_version": 2.0,
    "id": "topomap",
    "name": "Zabbix Auto Topology Map",
    "namespace": "Topomap",
    "version": "1.0.28",
    "author": "Peterson Basso/火星小魏/火星小刘",
    "description": "Automatically discover and generate network topology maps./自动发现生成网络拓扑图",
    "actions": {
        "topomap.view": {
            "class": "TopomapView",
            "layout": "layout.htmlpage",
            "view": "topomap.view"
        },
        "topomap.data": {
            "class": "TopomapData",
            "layout": "layout.json"
        }
    },
    "assets": {
        "js": ["topomap.js"],
        "css": ["topomap.css"]
    }
}
