{
  "manifest_version": 2.0,
  "id": "zabbix-backup-mysql",
  "name": "Zabbix MySQL Backup",
  "author": "火星小刘",
  "url": "https://github.com/X-Mars/zabbix_modules",
  "version": "2.0.3",
  "namespace": "ZabbixBackupMysql",
  "description": "Export the Zabbix MySQL or MariaDB database.",
  "actions": {
    "backupmysql": {
      "class": "BackupMysql",
      "view": "backupmysql"
    }
  },
  "assets": {
    "css": ["backup.css"],
    "js": ["backup.js"]
  }
}
