{
    "manifest_version": 2.0,
    "id": "zabbix-rack",
    "name": "Zabbix Rack",
    "version": "1.1.0",
    "namespace": "ZabbixRack",
    "author": "火星小刘",
    "url": "https://github.com/X-Mars/zabbix_modules",
    "description": "Manage server rooms and racks, and visually assign Zabbix hosts to individual rack units. / 管理机房和机柜，以可视化方式将 Zabbix 主机分配到指定 U 位。",
    "actions": {
        "rack.view": {
            "class": "RackView",
            "view": "rack.view"
        },
        "rack.manage": {
            "class": "RackManage",
            "view": "rack.manage"
        },
        "room.save": {
            "class": "RoomSave"
        },
        "room.delete": {
            "class": "RoomDelete"
        },
        "rack.save": {
            "class": "RackSave"
        },
        "rack.delete": {
            "class": "RackDelete"
        },
        "host.assign": {
            "class": "HostAssign"
        },
        "host.remove": {
            "class": "HostRemove"
        },
        "hosts.get": {
            "class": "HostsGet"
        },
        "host.problems": {
            "class": "HostProblems"
        },
        "rack.problems.refresh": {
            "class": "RackProblemsRefresh"
        }
    }
}
